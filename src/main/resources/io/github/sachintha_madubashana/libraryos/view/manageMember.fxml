<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" spacing="24.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.sachintha_madubashana.libraryos.controller.ManageMemberController">
   <children>
      <HBox alignment="CENTER_LEFT" prefWidth="600.0" spacing="8.0">
         <children>
            <Label alignment="CENTER" prefHeight="34.0" prefWidth="70.0" text="SORT" />
            <ComboBox prefWidth="150.0" promptText="Select" />
            <Pane prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <TextField promptText="Search by name, ID, or email..." />
            <Button mnemonicParsing="false" text="Button" />
         </children>
      </HBox>
      <TableView prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn editable="false" prefWidth="75.0" text="Member ID" />
          <TableColumn editable="false" prefWidth="75.0" text="Full Name" />
            <TableColumn editable="false" prefWidth="75.0" text="Email" />
            <TableColumn editable="false" prefWidth="75.0" text="Address" />
            <TableColumn editable="false" prefWidth="75.0" text="Joined" />
            <TableColumn editable="false" prefWidth="75.0" text="Actions" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label text="Showing 6 of 6 members" />
            <Pane HBox.hgrow="ALWAYS" />
            <HBox spacing="4.0">
               <children>
                  <Button mnemonicParsing="false" text="Previous" />
                  <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" text="1" />
                  <Button mnemonicParsing="false" text="2" />
                  <Button mnemonicParsing="false" text="3" />
                  <Button layoutX="196.0" layoutY="10.0" mnemonicParsing="false" text="Next" />
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>
