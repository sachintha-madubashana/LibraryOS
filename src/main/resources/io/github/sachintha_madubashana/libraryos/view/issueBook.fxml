<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.sachintha_madubashana.libraryos.controller.component.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="root" styleClass="container-spacing-with-padding" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.sachintha_madubashana.libraryos.controller.IssueBookController">
   <children>
      <VBox fx:id="column1" minWidth="300.0">
         <children>
            <VBox styleClass="card">
               <children>
                  <Label text="Issue Details" />
                  <DropdownSelect fx:id="memberDropdown" labelText="Member" maxWidth="400.0" prefWidth="250.0" required="true" HBox.hgrow="ALWAYS" />
                  <DropdownSelect fx:id="bookDropdown" labelText="Book" layoutX="10.0" layoutY="28.0" maxWidth="400.0" prefWidth="250.0" required="true" />
                  <InputField fx:id="issueDateInput" iconEnabled="false" iconLiteral="" inputType="DATE" labelText="Issue Date" promptText="02/10/2026" required="true" />
                  <InputField fx:id="dueDateInput" iconEnabled="false" iconLiteral="" inputType="DATE" labelText="Due Date" layoutX="10.0" layoutY="114.0" promptText="03/10/2026" required="true" />
                  <HBox styleClass="container-spacing">
                     <children>
                        <Button fx:id="issueBtn" alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="button-primary" text="Issue Book" HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearBtn" alignment="CENTER" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" styleClass="button-outline" text="Clear" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Region maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <Separator maxHeight="1.7976931348623157E308" orientation="VERTICAL" />
      <VBox fx:id="column2" maxHeight="1.7976931348623157E308" minWidth="300.0" HBox.hgrow="ALWAYS" />
      <Separator layoutX="263.0" layoutY="10.0" maxHeight="1.7976931348623157E308" orientation="VERTICAL" />
      <VBox fx:id="column3" maxHeight="1.7976931348623157E308" minWidth="300.0" HBox.hgrow="ALWAYS" />
   </children>
</HBox>
