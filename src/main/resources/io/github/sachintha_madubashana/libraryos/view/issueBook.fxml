<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.sachintha_madubashana.libraryos.controller.component.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="root" fillHeight="false" styleClass="container-spacing-with-padding" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.sachintha_madubashana.libraryos.controller.IssueBookController">
   <children>
      <VBox maxWidth="1.7976931348623157E308" styleClass="card">
         <children>
            <Label text="Issue Details" />
            <DropdownSelect fx:id="memberDropdown" labelText="Member" maxWidth="400.0" prefWidth="250.0" required="true" HBox.hgrow="ALWAYS" />
            <DropdownSelect fx:id="bookDropdown" labelText="Book" layoutX="10.0" layoutY="28.0" maxWidth="400.0" prefWidth="250.0" required="true" />
            <InputField fx:id="issueDateInput" iconEnabled="false" iconLiteral="" inputType="DATE" labelText="Issue Date" promptText="02-10-2026" required="true" />
            <InputField fx:id="dueDateInput" iconEnabled="false" iconLiteral="" inputType="DATE" labelText="Due Date" layoutX="10.0" layoutY="114.0" promptText="03-10-2026" required="true" />
            <Button alignment="CENTER" mnemonicParsing="false" styleClass="button-primary" text="Issue Book" />
         </children></VBox>
      <Separator maxHeight="1.7976931348623157E308" orientation="VERTICAL" />
      <VBox maxHeight="1.7976931348623157E308">
         <children>
            <VBox maxHeight="1.7976931348623157E308" prefHeight="450.0" prefWidth="300.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="text-caption" text="Member Info" />
                  <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="text-label-sm" text="Select A Member" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
      <VBox maxHeight="1.7976931348623157E308">
         <children>
            <VBox maxHeight="1.7976931348623157E308" prefHeight="450.0" prefWidth="300.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="text-caption" text="Book Info" />
                  <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="text-label-sm" text="Select A Book" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>
